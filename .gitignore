# ─────────────────────────────────────────────────────────────
#  Scriptura — .gitignore
#
#  NOTE: data/ is intentionally NOT ignored. The normalized Bible
#  JSON is the product of this repo and must be committed. Only the
#  RAW source downloads (.cache/) are ignored — see below.
# ─────────────────────────────────────────────────────────────

# ─── Node / npm dependencies ───
node_modules/
.pnp
.pnp.*
.npm/

# ─── TypeScript / package build output ───
dist/
build/
lib/
packages/*/dist/
packages/*/lib/
*.tsbuildinfo

# ─── Ingestion download cache (scripts/ingest.py) ───
# Raw USFX/JSON fetched from eBible, aruljohn, etc. Regenerable — never commit.
.cache/

# ─── AWS / deploy artifacts ───
# Generated by the static-API build and the Lambda packaging step.
lambda.zip
*.zip
!data/**/*.zip

# ─── Python ───
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ─── Testing / coverage ───
coverage/
.nyc_output/

# ─── Environment / secrets ───
# Never commit credentials. AWS auth flows through GitHub OIDC / Secrets.
.env
.env.*
!.env.example

# ─── Logs ───
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Editor / IDE ───
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS cruft ───
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db