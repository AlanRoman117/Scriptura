{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // A type imported without the `type` keyword survives transpilation under
    // Vite, which is how `import { Verse } from '@scriptura/core'` would drag
    // node:fs into the bundle. The packages set this too now that they emit
    // ESM, so the rule is the same everywhere rather than only here.
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true
  },
  "include": ["src", "vite.config.ts", "scripts"]
}
