{
  "name": "@scriptura/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Loader, parser, and canonical TypeScript types for Scriptura Bible data.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlanRoman117/scriptura.git",
    "directory": "packages/core"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./books": {
      "types": "./dist/books.d.ts",
      "default": "./dist/books.js"
    },
    "./bible": {
      "types": "./dist/bible.d.ts",
      "default": "./dist/bible.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  }
}
