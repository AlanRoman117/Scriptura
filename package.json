{
  "name": "scriptura",
  "version": "0.1.0",
  "description": "Open Bible data ecosystem — multi-translation, multi-language, developer-first.",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/node-server",
    "examples/cli-demo"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "jest",
    "validate": "python scripts/validate.py",
    "check:canon": "python scripts/check-canon-sync.py",
    "lint": "tsc --build",
    "start:api": "npm run build && node examples/node-server/dist/index.js",
    "dev:api": "tsx watch --tsconfig tsconfig.dev.json examples/node-server/src/index.ts",
    "build:api": "node scripts/build-static-api.mjs",
    "schema:gen": "tsx scripts/schema-gen.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AlanRoman117/scriptura.git"
  },
  "keywords": [
    "bible",
    "scripture",
    "translations",
    "open-data",
    "kjv",
    "search",
    "api"
  ],
  "author": "Alan Roman",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
