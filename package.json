{
  "name": "scriptura",
  "version": "0.1.0",
  "description": "Open Bible data ecosystem — multi-translation, multi-language, developer-first.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build packages/*/tsconfig.json",
    "test": "jest",
    "validate": "python scripts/validate.py",
    "lint": "tsc --noEmit",
    "start:api": "node examples/node-server/dist/index.js",
    "schema:gen": "ts-node scripts/schema-gen.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AlanRoman117/scriptura.git"
  },
  "keywords": [
    "bible",
    "scripture",
    "translations",
    "open-data",
    "kjv",
    "search",
    "api"
  ],
  "author": "Alan Roman",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  }
}
